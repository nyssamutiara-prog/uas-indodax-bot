# Salin file ini menjadi .env (JANGAN di-commit). Isi nilai aslinya di Vercel > Settings > Environment Variables.
CRON_SECRET=isi_string_acak_panjang
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kill switch: ubah ke 1 di Vercel (lalu Redeploy tidak perlu) ATAU set key "killswitch" = 1 di Redis
KILL_SWITCH=0
